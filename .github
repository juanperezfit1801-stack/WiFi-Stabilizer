workflows
build.yml
name: Build WiFi Stabilizer

on:
  push:
    branches:
      - main

  workflow_dispatch:

jobs:

  build:

    runs-on: windows-latest

    steps:

      - name: Descargar código
        uses: actions/checkout@v4

      - name: Instalar .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '8.0.x'

      - name: Restaurar dependencias
        run: dotnet restore WiFiStabilizer.csproj

      - name: Compilar aplicación
        run: |
          dotnet publish WiFiStabilizer.csproj `
            -c Release `
            -r win-x64 `
            --self-contained true `
            -p:PublishSingleFile=true `
            -p:IncludeNativeLibrariesForSelfExtract=true `
            -o publish

      - name: Crear ZIP
        run: |
          Compress-Archive `
            -Path publish\* `
            -DestinationPath WiFiStabilizer-Windows-x64.zip

      - name: Guardar aplicación
        uses: actions/upload-artifact@v4
        with:
          name: WiFi-Stabilizer-Windows
          path: WiFiStabilizer-Windows-x64.zip
