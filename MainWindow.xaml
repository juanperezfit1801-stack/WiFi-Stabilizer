<Window x:Class="WiFiStabilizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WiFi Stabilizer"
        Width="1050"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        Background="#0B1220"
        Foreground="#F1F5F9">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Grid Grid.Row="0" Margin="0,0,0,20">

            <StackPanel>
                <TextBlock Text="WiFi Stabilizer"
                           FontSize="30"
                           FontWeight="Bold"/>

                <TextBlock Text="Monitor de conexión en tiempo real"
                           FontSize="14"
                           Foreground="#94A3B8"/>
            </StackPanel>

            <Border HorizontalAlignment="Right"
                    Background="#123B2A"
                    CornerRadius="15"
                    Padding="16,8">

                <TextBlock x:Name="StatusText"
                           Text="● INICIANDO"
                           Foreground="#4ADE80"
                           FontWeight="Bold"/>

            </Border>

        </Grid>

        <!-- METRICS -->

        <Grid Grid.Row="1" Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#111C2E"
                    CornerRadius="12"
                    Padding="18"
                    Margin="0,0,10,0">

                <StackPanel>
                    <TextBlock Text="SEÑAL"
                               Foreground="#94A3B8"/>

                    <TextBlock x:Name="SignalText"
                               Text="-- %"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,6,0,0"/>

                    <TextBlock x:Name="SignalQualityText"
                               Text="Analizando..."
                               Foreground="#38BDF8"/>
                </StackPanel>

            </Border>

            <Border Grid.Column="1"
                    Background="#111C2E"
                    CornerRadius="12"
                    Padding="18"
                    Margin="10,0">

                <StackPanel>
                    <TextBlock Text="PING"
                               Foreground="#94A3B8"/>

                    <TextBlock x:Name="PingText"
                               Text="-- ms"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,6,0,0"/>

                    <TextBlock Text="Latencia"
                               Foreground="#38BDF8"/>
                </StackPanel>

            </Border>

            <Border Grid.Column="2"
                    Background="#111C2E"
                    CornerRadius="12"
                    Padding="18"
                    Margin="10,0">

                <StackPanel>
                    <TextBlock Text="PÉRDIDA"
                               Foreground="#94A3B8"/>

                    <TextBlock x:Name="LossText"
                               Text="-- %"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,6,0,0"/>

                    <TextBlock Text="Paquetes"
                               Foreground="#38BDF8"/>
                </StackPanel>

            </Border>

            <Border Grid.Column="3"
                    Background="#111C2E"
                    CornerRadius="12"
                    Padding="18"
                    Margin="10,0,0,0">

                <StackPanel>
                    <TextBlock Text="ESTABILIDAD"
                               Foreground="#94A3B8"/>

                    <TextBlock x:Name="StabilityText"
                               Text="-- %"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,6,0,0"/>

                    <TextBlock Text="Conexión"
                               Foreground="#38BDF8"/>
                </StackPanel>

            </Border>

        </Grid>

        <!-- CONTENT -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- GRAPH -->

            <Border Grid.Column="0"
                    Background="#111C2E"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,10,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="SEÑAL EN TIEMPO REAL"
                               FontSize="16"
                               FontWeight="Bold"/>

                    <Canvas x:Name="GraphCanvas"
                            Grid.Row="1"
                            Background="#0D1728"
                            Margin="0,15,0,0"/>

                </Grid>

            </Border>

            <!-- DETAILS -->

            <Border Grid.Column="1"
                    Background="#111C2E"
                    CornerRadius="12"
                    Padding="20"
                    Margin="10,0,0,0">

                <StackPanel>

                    <TextBlock Text="INFORMACIÓN WI-FI"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="SSID"
                               Foreground="#94A3B8"/>

                    <TextBlock x:Name="SsidText"
                               Text="-"
                               FontSize="16"
                               Margin="0,4,0,15"/>

                    <TextBlock Text="BSSID"
                               Foreground="#94A3B8"/>

                    <TextBlock x:Name="BssidText"
                               Text="-"
                               Margin="0,4,0,15"/>

                    <TextBlock Text="CANAL"
                               Foreground="#94A3B8"/>

                    <TextBlock x:Name="ChannelText"
                               Text="-"
                               FontSize="16"
                               Margin="0,4,0,15"/>

                    <TextBlock Text="FRECUENCIA / RADIO"
                               Foreground="#94A3B8"/>

                    <TextBlock x:Name="RadioText"
                               Text="-"
                               Margin="0,4,0,15"/>

                    <TextBlock Text="VELOCIDAD RX"
                               Foreground="#94A3B8"/>

                    <TextBlock x:Name="RxText"
                               Text="-"
                               Margin="0,4,0,15"/>

                    <TextBlock Text="VELOCIDAD TX"
                               Foreground="#94A3B8"/>

                    <TextBlock x:Name="TxText"
                               Text="-"
                               Margin="0,4,0,20"/>

                    <CheckBox x:Name="AutoReconnectCheck"
                              Content="Reconexión automática"
                              IsChecked="True"
                              FontSize="14"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- FOOTER -->

        <DockPanel Grid.Row="3"
                   Margin="0,20,0,0">

            <TextBlock x:Name="LastUpdateText"
                       Text="Última actualización: --"
                       Foreground="#64748B"/>

            <Button x:Name="OptimizeButton"
                    Content="⚙ ESTABILIZACIÓN AUTOMÁTICA"
                    HorizontalAlignment="Right"
                    Padding="18,10"
                    Background="#0284C7"
                    Foreground="White"
                    BorderThickness="0"
                    Click="OptimizeButton_Click"/>

        </DockPanel>

    </Grid>

</Window>
