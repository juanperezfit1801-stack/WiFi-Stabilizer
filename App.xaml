<Application x:Class="WiFiStabilizer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">

    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0B1220"/>
        <SolidColorBrush x:Key="CardBrush" Color="#111C2E"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8"/>
    </Application.Resources>

</Application>
